<?xml version="1.0" encoding="UTF-8" ?>
<project name="MentorQ_MVP.dbs" database="MongoDb" id="c8e1f5a9-4b2c-4f81-9f22-7e0f81d13b2a" >
	<schema name="mentorq_db" >
		<table name="mentor_profiles" spec="" >
			<comment><![CDATA[Contains mentor-specific availability, dynamic minute pools, and skill expertise.]]></comment>
			<column name="_id" type="string" length="24" mandatory="y" />
			<column name="user_id" type="string" length="24" mandatory="y" />
			<column name="expertise_tags" type="array" mandatory="y" />
			<column name="daily_available_minutes" type="int" mandatory="y" >
				<defo><![CDATA[90]]></defo>
			</column>
			<column name="remaining_minutes_today" type="int" mandatory="y" >
				<defo><![CDATA[90]]></defo>
			</column>
			<column name="is_online" type="boolean" mandatory="y" >
				<defo><![CDATA[true]]></defo>
			</column>
			<column name="operating_hours" type="object" mandatory="y" >
				<column name="start" type="string" length="5" mandatory="y" />
				<column name="end" type="string" length="5" mandatory="y" />
				<column name="timezone" type="string" length="64" mandatory="y" >
					<defo><![CDATA['Asia/Kolkata']]></defo>
				</column>
			</column>
			<column name="updated_at" type="timestamp" mandatory="y" />
			<index name="pk_mentor_profiles" unique="PRIMARY_KEY" >
				<column name="_id" />
			</index>
			<index name="ux_mentor_profiles_user_id" unique="UNIQUE_INDEX" >
				<column name="user_id" />
			</index>
			<index name="ix_mentor_profiles_is_online" unique="NORMAL" >
				<column name="is_online" />
			</index>
			<fk name="fk_mentor_profiles_user" to_schema="mentorq_db" to_table="users" >
				<fk_column name="user_id" pk="_id" />
			</fk>
		</table>
		<table name="notifications" spec="" >
			<comment><![CDATA[Real-time queue progression updates and system alerts for users.]]></comment>
			<column name="_id" type="string" length="24" mandatory="y" />
			<column name="user_id" type="string" length="24" mandatory="y" />
			<column name="type" type="string" length="32" mandatory="y" />
			<column name="title" type="string" length="255" mandatory="y" />
			<column name="message" type="string" mandatory="y" />
			<column name="metadata" type="object" >
				<column name="ticket_id" type="string" length="24" />
				<column name="action_url" type="string" length="512" />
			</column>
			<column name="is_read" type="boolean" mandatory="y" >
				<defo><![CDATA[false]]></defo>
			</column>
			<column name="created_at" type="timestamp" mandatory="y" />
			<index name="pk_notifications" unique="PRIMARY_KEY" >
				<column name="_id" />
			</index>
			<index name="ix_notifications_user_unread" unique="NORMAL" >
				<column name="user_id" />
				<column name="is_read" />
				<column name="created_at" />
			</index>
			<fk name="fk_notifications_user" to_schema="mentorq_db" to_table="users" >
				<fk_column name="user_id" pk="_id" />
			</fk>
		</table>
		<table name="reviews" spec="" >
			<comment><![CDATA[Post-session 1-5 star ratings and feedback for doubt clearance quality.]]></comment>
			<column name="_id" type="string" length="24" mandatory="y" />
			<column name="ticket_id" type="string" length="24" mandatory="y" />
			<column name="student_id" type="string" length="24" mandatory="y" />
			<column name="mentor_id" type="string" length="24" mandatory="y" />
			<column name="rating" type="int" mandatory="y" />
			<column name="comment" type="string" />
			<column name="created_at" type="timestamp" mandatory="y" />
			<index name="pk_reviews" unique="PRIMARY_KEY" >
				<column name="_id" />
			</index>
			<index name="ux_reviews_ticket_id" unique="UNIQUE_INDEX" >
				<column name="ticket_id" />
			</index>
			<index name="ix_reviews_mentor_rating" unique="NORMAL" >
				<column name="mentor_id" />
				<column name="rating" />
			</index>
			<constraint name="cns_reviews_rating" >
				<string><![CDATA[rating BETWEEN 1 AND 5]]></string>
			</constraint>
			<fk name="fk_reviews_ticket" to_schema="mentorq_db" to_table="tickets" >
				<fk_column name="ticket_id" pk="_id" />
			</fk>
			<fk name="fk_reviews_student" to_schema="mentorq_db" to_table="users" >
				<fk_column name="student_id" pk="_id" />
			</fk>
			<fk name="fk_reviews_mentor" to_schema="mentorq_db" to_table="users" >
				<fk_column name="mentor_id" pk="_id" />
			</fk>
		</table>
		<table name="sessions" spec="" >
			<comment><![CDATA[Tracks live execution, WebSocket countdown timers, and duration reconciliation.]]></comment>
			<column name="_id" type="string" length="24" mandatory="y" />
			<column name="ticket_id" type="string" length="24" mandatory="y" />
			<column name="mentor_id" type="string" length="24" mandatory="y" />
			<column name="student_id" type="string" length="24" mandatory="y" />
			<column name="started_at" type="timestamp" mandatory="y" />
			<column name="allocated_minutes" type="int" mandatory="y" />
			<column name="extended_minutes" type="int" mandatory="y" >
				<defo><![CDATA[0]]></defo>
			</column>
			<column name="ended_at" type="timestamp" />
			<column name="actual_duration_minutes" type="int" mandatory="y" >
				<defo><![CDATA[0]]></defo>
			</column>
			<column name="session_status" type="string" length="16" mandatory="y" >
				<defo><![CDATA['ACTIVE']]></defo>
			</column>
			<column name="resolution_notes" type="string" />
			<index name="pk_sessions" unique="PRIMARY_KEY" >
				<column name="_id" />
			</index>
			<index name="ux_sessions_ticket_id" unique="UNIQUE_INDEX" >
				<column name="ticket_id" />
			</index>
			<index name="ix_sessions_mentor_status" unique="NORMAL" >
				<column name="mentor_id" />
				<column name="session_status" />
			</index>
			<constraint name="cns_sessions_status" >
				<string><![CDATA[session_status IN ('ACTIVE','COMPLETED','TERMINATED')]]></string>
			</constraint>
			<fk name="fk_sessions_ticket" to_schema="mentorq_db" to_table="tickets" >
				<fk_column name="ticket_id" pk="_id" />
			</fk>
			<fk name="fk_sessions_mentor" to_schema="mentorq_db" to_table="users" >
				<fk_column name="mentor_id" pk="_id" />
			</fk>
			<fk name="fk_sessions_student" to_schema="mentorq_db" to_table="users" >
				<fk_column name="student_id" pk="_id" />
			</fk>
		</table>
		<table name="ticket_messages" spec="" >
			<comment><![CDATA[Pre-session and active guidance messaging (e.g., self-research links, code snippets).]]></comment>
			<column name="_id" type="string" length="24" mandatory="y" />
			<column name="ticket_id" type="string" length="24" mandatory="y" />
			<column name="sender_id" type="string" length="24" mandatory="y" />
			<column name="content" type="string" mandatory="y" />
			<column name="attachment_url" type="string" length="1024" />
			<column name="is_quick_reply" type="boolean" mandatory="y" >
				<defo><![CDATA[false]]></defo>
			</column>
			<column name="created_at" type="timestamp" mandatory="y" />
			<index name="pk_ticket_messages" unique="PRIMARY_KEY" >
				<column name="_id" />
			</index>
			<index name="ix_ticket_messages_ticket_created" unique="NORMAL" >
				<column name="ticket_id" />
				<column name="created_at" />
			</index>
			<fk name="fk_ticket_messages_ticket" to_schema="mentorq_db" to_table="tickets" >
				<fk_column name="ticket_id" pk="_id" />
			</fk>
			<fk name="fk_ticket_messages_sender" to_schema="mentorq_db" to_table="users" >
				<fk_column name="sender_id" pk="_id" />
			</fk>
		</table>
		<table name="tickets" spec="" >
			<comment><![CDATA[Queue management tickets submitted by students for doubt resolution.]]></comment>
			<column name="_id" type="string" length="24" mandatory="y" />
			<column name="student_id" type="string" length="24" mandatory="y" />
			<column name="mentor_id" type="string" length="24" mandatory="y" />
			<column name="topic" type="string" length="255" mandatory="y" />
			<column name="description" type="string" mandatory="y" />
			<column name="requested_minutes" type="int" mandatory="y" >
				<defo><![CDATA[15]]></defo>
			</column>
			<column name="status" type="string" length="16" mandatory="y" >
				<defo><![CDATA['PENDING']]></defo>
			</column>
			<column name="scheduled_time" type="timestamp" />
			<column name="actual_time_spent_minutes" type="int" mandatory="y" >
				<defo><![CDATA[0]]></defo>
			</column>
			<column name="tags" type="array" />
			<column name="status_history" type="array" >
				<column name="status" type="string" length="16" mandatory="y" />
				<column name="timestamp" type="timestamp" mandatory="y" />
				<column name="feedback_note" type="string" />
			</column>
			<column name="created_at" type="timestamp" mandatory="y" />
			<column name="updated_at" type="timestamp" mandatory="y" />
			<index name="pk_tickets" unique="PRIMARY_KEY" >
				<column name="_id" />
			</index>
			<index name="ix_tickets_student_id" unique="NORMAL" >
				<column name="student_id" />
			</index>
			<index name="ix_tickets_mentor_id" unique="NORMAL" >
				<column name="mentor_id" />
			</index>
			<index name="ix_tickets_status" unique="NORMAL" >
				<column name="status" />
			</index>
			<index name="ix_tickets_mentor_status_created" unique="NORMAL" >
				<column name="mentor_id" />
				<column name="status" />
				<column name="created_at" />
			</index>
			<constraint name="cns_tickets_status" >
				<string><![CDATA[status IN ('PENDING','APPROVED','REJECTED','ACTIVE','COMPLETED')]]></string>
			</constraint>
			<fk name="fk_tickets_student" to_schema="mentorq_db" to_table="users" >
				<fk_column name="student_id" pk="_id" />
			</fk>
			<fk name="fk_tickets_mentor" to_schema="mentorq_db" to_table="users" >
				<fk_column name="mentor_id" pk="_id" />
			</fk>
		</table>
		<table name="users" spec="" >
			<comment><![CDATA[Stores core user accounts for Students, Mentors, and Admins.]]></comment>
			<column name="_id" type="string" length="24" mandatory="y" />
			<column name="full_name" type="string" length="255" mandatory="y" />
			<column name="email" type="string" length="320" mandatory="y" />
			<column name="password_hash" type="string" length="255" mandatory="y" />
			<column name="role" type="string" length="16" mandatory="y" >
				<defo><![CDATA['STUDENT']]></defo>
			</column>
			<column name="avatar_url" type="string" length="1024" />
			<column name="created_at" type="timestamp" mandatory="y" />
			<column name="updated_at" type="timestamp" mandatory="y" />
			<index name="pk_users" unique="PRIMARY_KEY" >
				<column name="_id" />
			</index>
			<index name="ux_users_email" unique="UNIQUE_INDEX" >
				<column name="email" />
			</index>
			<index name="ix_users_role" unique="NORMAL" >
				<column name="role" />
			</index>
			<constraint name="cns_users_role" >
				<string><![CDATA[role IN ('STUDENT', 'MENTOR', 'ADMIN')]]></string>
			</constraint>
		</table>
	</schema>
	<diagram_group name="MentorQ MVP Model" id="9b0a1f23-8c7e-41d5-bc44-3e9185a67210" >
		<diagram name="MentorQ MVP Diagram" id="e14c8f2b-94aa-43d9-95e3-183617b8f9e0" show_relation="columns" >
			<entity schema="mentorq_db" name="mentor_profiles" color="2A6F97" x="76" y="665" />
			<entity schema="mentorq_db" name="notifications" color="468FAF" x="57" y="57" />
			<entity schema="mentorq_db" name="reviews" color="2A6F97" x="912" y="684" />
			<entity schema="mentorq_db" name="sessions" color="014F86" x="912" y="285" />
			<entity schema="mentorq_db" name="ticket_messages" color="013A63" x="494" y="779" />
			<entity schema="mentorq_db" name="tickets" color="014F86" x="494" y="285" />
			<entity schema="mentorq_db" name="users" color="2A6F97" x="76" y="285" />
		</diagram>
	</diagram_group>
</project>
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MENTOR
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  mentorProfile MentorProfile?
  tickets       Ticket[]     @relation("AuthoredTickets")
  assigned      Ticket[]     @relation("AssignedTickets")

  @@index([email, role])
  @@index([deletedAt])
  auditLogs     AuditLog[]
}

model MentorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  hourlyRate     Decimal  @db.Decimal(10, 2)
  isAvailable    Boolean  @default(true)
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          String       @id @default(uuid())
  title       String
  description String
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  authorId    String
  author      User         @relation("AuthoredTickets", fields: [authorId], references: [id], onDelete: Restrict)
  assigneeId  String?
  assignee    User?        @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status, priority])
  @@index([authorId])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityId    String
  entityType  String
  timestamp   DateTime @default(now())
  metadata    Json?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
